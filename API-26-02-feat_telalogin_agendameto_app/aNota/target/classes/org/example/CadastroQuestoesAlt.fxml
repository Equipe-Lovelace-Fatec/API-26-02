<ScrollPane stylesheets="@../../style.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.Controller">
    <content>
        <AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="1336.0" prefWidth="1350.0">
            <children>
                <ImageView fitHeight="1344.0" fitWidth="1352.0" layoutX="-2.0" layoutY="-4.0">
                    <image>
                        <Image url="@../../telas.png/CadastroQuestoesAlt.png" />
                    </image>
                </ImageView>

                <MenuButton fx:id="btnQuestoes" layoutX="382.0" layoutY="21.0" mnemonicParsing="false" onAction="#irQuestao" prefHeight="38.0" prefWidth="183.0" style="-fx-background-color: transparent;">
