                    <cursor>
                        <Cursor fx:constant="HAND" />
                    </cursor>
                </MenuButton>

                <MenuButton fx:id="btnProva" layoutX="583.0" layoutY="22.0" mnemonicParsing="false" onAction="#irProva" prefHeight="38.0" prefWidth="184.0" style="-fx-background-color: transparent;">
