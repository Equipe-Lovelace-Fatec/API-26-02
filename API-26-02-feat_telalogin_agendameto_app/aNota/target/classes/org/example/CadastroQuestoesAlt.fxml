                <TextArea fx:id="txtAlternativa2" layoutX="181.0" layoutY="813.0" prefHeight="39.0" prefWidth="1071.0" promptText="Digite a alternativa 2" style="-fx-border-color: #00c1cf; -fx-border-radius: 10;" wrapText="true">
                    <font>
