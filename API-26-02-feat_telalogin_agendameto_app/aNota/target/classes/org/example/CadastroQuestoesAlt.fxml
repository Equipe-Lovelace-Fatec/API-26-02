                </MenuButton>

                <ScrollPane layoutX="142.0" layoutY="439.0" prefHeight="118.0" prefWidth="1093.0" style="-fx-border-color: #00c1cf; -fx-border-radius: 10;">
                    <content>
                        <TextArea fx:id="txtPergunta" prefHeight="139.0" prefWidth="1086.0" promptText="Digite o enunciado" style="-fx-border-color: #00c1cf; -fx-border-radius: 10;" wrapText="true">
                            <font>
                                <Font size="24.0" />
                            </font>
