                <TextArea fx:id="txtAlternativa3" layoutX="181.0" layoutY="930.0" prefHeight="54.0" prefWidth="1071.0" promptText="Digite a alternativa 3" style="-fx-border-color: #00c1cf; -fx-border-radius: 10;" wrapText="true">
                    <font>
                        <Font size="24.0" />
                    </font>
                </TextArea>

                <TextArea fx:id="txtAlternativa4" layoutX="180.0" layoutY="1042.0" prefHeight="54.0" prefWidth="1071.0" promptText="Digite a alternativa 4" style="-fx-border-color: #00c1cf; -fx-border-radius: 10;" wrapText="true">
                    <font>
                        <Font size="24.0" />
                    </font>
                </TextArea>

                <ComboBox fx:id="comboDisciplina" layoutX="271.0" layoutY="333.0" prefHeight="31.0" prefWidth="108.0" promptText="Selecione" style="-fx-background-color: transparent; -fx-background-radius: 60; -fx-border-color: #005c6d;" />
                <ComboBox fx:id="comboTema" layoutX="617.0" layoutY="334.0" prefHeight="31.0" prefWidth="108.0" promptText="Selecione" style="-fx-background-color: transparent; -fx-background-radius: 60; -fx-border-color: #005c6d;" />
                <ComboBox fx:id="comboDificuldade" layoutX="1034.0" layoutY="335.0" prefHeight="31.0" prefWidth="108.0" promptText="Selecione" style="-fx-background-color: transparent; -fx-background-radius: 60; -fx-border-color: #005c6d;" />
