                <MenuButton fx:id="btnAlunos" layoutX="800.0" layoutY="22.0" mnemonicParsing="false" prefHeight="38.0" prefWidth="182.0" style="-fx-background-color: transparent;">
                    <items>
                        <MenuItem fx:id="btalunos_notas" mnemonicParsing="false" onAction="#irAlunos_notas" text="Notas" />
                        <MenuItem fx:id="btalunos_corrigir" mnemonicParsing="false" onAction="#irAlunos_corrigir" text="Corrigir" />
                    </items>
                    <cursor>
                        <Cursor fx:constant="HAND" />
