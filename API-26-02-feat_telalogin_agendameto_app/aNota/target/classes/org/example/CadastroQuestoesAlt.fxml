                <TextArea fx:id="txtAlternativa1" layoutX="180.0" layoutY="700.0" prefHeight="39.0" prefWidth="1071.0" promptText="Digite a alternativa 1" style="-fx-border-color: #00c1cf; -fx-border-radius: 10;" wrapText="true">
                    <font>
                        <Font size="24.0" />
