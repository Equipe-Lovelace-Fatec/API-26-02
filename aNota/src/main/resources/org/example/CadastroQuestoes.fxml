<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<ScrollPane stylesheets="@../../style.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.Controller">
    <content>
        <AnchorPane prefHeight="1166.0" prefWidth="1348.0">

            <children>

                <ImageView fitHeight="1178.0" fitWidth="1352.0" layoutX="-5.0" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@../../telas.png/CadastroQuestoes.png" />
                    </image>
                </ImageView>

                <MenuButton fx:id="btnProva" layoutX="746.0" layoutY="37.0" mnemonicParsing="false" onAction="#irProva" prefHeight="39.0" prefWidth="182.0" style="-fx-background-color: transparent;">
                    <items>
                        <MenuItem fx:id="btProva_montar" mnemonicParsing="false" onAction="#IrProva_montar" text="Montar" />
                        <MenuItem fx:id="btProva_agendar" mnemonicParsing="false" onAction="#irProva_agendar" text="Agendar" />
                    </items>
                    <cursor>
                        <Cursor fx:constant="HAND" />
                    </cursor>
                </MenuButton>

                <MenuButton fx:id="btnAlunos" layoutX="1115.0" layoutY="37.0" mnemonicParsing="false" onAction="#irAlunos" prefHeight="38.0" prefWidth="180.0" style="-fx-background-color: transparent;">
                    <items>
                        <MenuItem fx:id="btalunos_notas" mnemonicParsing="false" onAction="#irAlunos_notas" text="Notas" />
                        <MenuItem fx:id="btalunos_corrigir" mnemonicParsing="false" onAction="#irAlunos_corrigir" text="Corrigir" />
                    </items>
                    <cursor>
                        <Cursor fx:constant="HAND" />
                    </cursor>
                </MenuButton>

                <ScrollPane layoutX="133.0" layoutY="564.0" prefHeight="137.0" prefWidth="1094.0" style="-fx-border-color: #00c1cf; -fx-border-radius: 10;">
                    <content>
                        <TextArea fx:id="txtPergunta" prefHeight="178.0" prefWidth="1074.0" promptText="Digite o enunciado" style="-fx-border-radius: 10;">
                            <font>
                                <Font size="24.0" />
                            </font>
                        </TextArea>
                    </content>
                </ScrollPane>

                <Button fx:id="btMultipla" layoutX="487.0" layoutY="344.0" mnemonicParsing="false" onAction="#abrirMultipla" prefHeight="30.0" prefWidth="30.0" style="-fx-background-color: transparent;" />

                <Button layoutX="890.0" layoutY="979.0" mnemonicParsing="false" onAction="#salvarQuestao" prefHeight="60.0" prefWidth="343.0" style="-fx-background-color: transparent;" />

                <Button fx:id="btRelac" layoutX="837.0" layoutY="345.0" mnemonicParsing="false" onAction="#abrirRelac" prefHeight="30.0" prefWidth="30.0" style="-fx-background-color: transparent;" />
                <ScrollPane layoutX="132.0" layoutY="783.0" prefHeight="137.0" prefWidth="1094.0" style="-fx-border-color: #00c1cf; -fx-border-radius: 10;">
                    <content>
                        <TextArea fx:id="txtGabarito" prefHeight="178.0" prefWidth="1074.0" promptText="Digite a resposta" style="-fx-border-radius: 10;">
                            <font>
                                <Font size="24.0" />
                            </font>
                        </TextArea>
                    </content>
                </ScrollPane>
                <ComboBox fx:id="comboDisciplina" layoutX="273.0" layoutY="424.0" prefHeight="31.0" prefWidth="108.0" promptText="Selecione" style="-fx-background-color: transparent; -fx-background-radius: 60; -fx-border-color: #005c6d;" />
                <ComboBox fx:id="comboTema" layoutX="615.0" layoutY="424.0" prefHeight="31.0" prefWidth="108.0" promptText="Selecione" style="-fx-background-color: transparent; -fx-background-radius: 60; -fx-border-color: #005c6d;" />
                <ComboBox fx:id="comboDificuldade" layoutX="1048.0" layoutY="422.0" prefHeight="31.0" prefWidth="108.0" promptText="Selecione" style="-fx-background-color: transparent; -fx-background-radius: 60; -fx-border-color: #005c6d;" />
                <MenuButton fx:id="btnQuestoes" layoutX="374.0" layoutY="33.0" mnemonicParsing="false" onAction="#irQuestao" prefHeight="45.0" prefWidth="185.0" style="-fx-background-color: transparent;">
                    <items>
                        <MenuItem fx:id="btquestoes_criar" mnemonicParsing="false" onAction="#IrQuestao_criar" text="Criar" />
                        <MenuItem fx:id="btquestoes_consultar" mnemonicParsing="false" onAction="#irQuestao_consultar" text="Consultar" />
                    </items>
                    <cursor>
                        <Cursor fx:constant="HAND" />
                    </cursor>
                </MenuButton>

            </children>

        </AnchorPane>
    </content>
</ScrollPane>
