<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<ScrollPane stylesheets="@../../style.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.NotasController">
   <content>
      <Pane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="1156.0" prefWidth="1350.0">
         <children>
            <ImageView fitHeight="1164.0" fitWidth="1360.0" layoutX="-8.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../../telas.png/notas.png" />
               </image>
            </ImageView>
            <Pane fx:id="pane_principal" layoutX="87.0" layoutY="380.0" prefHeight="672.0" prefWidth="1172.0" style="-fx-background-color: #ffffff; -fx-background-radius: 5;">
               <children>
                  <ScrollPane fx:id="scroll_principal" fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="ALWAYS" layoutX="9.0" layoutY="9.0" prefHeight="638.0" prefWidth="1155.0" style="-fx-background-color: Transparent; -fx-background-radius: 5; -fx-border-color: #ffffff; -fx-border-radius: 5;">
                     <content>
                        <!-- Os cartões de aluno (CartaoAluno.fxml) são adicionados pela NotasController -->
                        <VBox fx:id="lista_alunos" spacing="14.0" style="-fx-background-color: #ffffff;">
                           <padding>
                              <Insets bottom="20.0" top="10.0" />
                           </padding>
                        </VBox>
                     </content>
                  </ScrollPane>
               </children>
            </Pane>
            <!-- Seleção da turma e do aluno -->
            <Pane fx:id="painel_selecao" layoutX="100.0" layoutY="244.0" prefHeight="62.0" prefWidth="1144.0" style="-fx-background-color: #e6f4f6; -fx-background-radius: 10; -fx-border-color: #00596a; -fx-border-radius: 10; -fx-border-width: 1.5;">
               <children>
                  <Label layoutX="20.0" layoutY="18.0" text="Turma:" textFill="#00596a">
                     <font>
                        <Font name="System Bold" size="16.0" />
                     </font>
                  </Label>
                  <ComboBox fx:id="combo_turma" layoutX="86.0" layoutY="10.0" prefHeight="42.0" prefWidth="640.0" style="-fx-font-size: 14;" />
                  <Label layoutX="754.0" layoutY="18.0" text="Aluno:" textFill="#00596a">
                     <font>
                        <Font name="System Bold" size="16.0" />
                     </font>
                  </Label>
                  <ComboBox fx:id="combo_aluno" layoutX="818.0" layoutY="10.0" prefHeight="42.0" prefWidth="308.0" style="-fx-font-size: 14;" />
               </children>
            </Pane>
            <MenuButton fx:id="btnQuestoes" layoutX="373.0" layoutY="35.0" mnemonicParsing="false" onAction="#irQuestao" opacity="0.0" prefHeight="46.0" prefWidth="185.0" style="-fx-background-color: transparent;">
               <items>
                  <MenuItem fx:id="btquestoes_criar" mnemonicParsing="false" onAction="#IrQuestao_criar" text="Criar" />
                  <MenuItem fx:id="btquestoes_consultar" mnemonicParsing="false" onAction="#irQuestao_consultar" text="Consultar" />
               </items>
               <cursor>
                  <Cursor fx:constant="HAND" />
               </cursor>
            </MenuButton>
            <MenuButton fx:id="btnProva" layoutX="740.0" layoutY="33.0" mnemonicParsing="false" onAction="#irProva" opacity="0.0" prefHeight="46.0" prefWidth="193.0" style="-fx-background-color: transparent;">
               <items>
                  <MenuItem fx:id="btProva_montar" mnemonicParsing="false" onAction="#IrProva_montar" text="Montar" />
                  <MenuItem fx:id="btProva_agendar" mnemonicParsing="false" onAction="#irProva_agendar" text="Agendar" />
                  <MenuItem fx:id="btProva_pesos" mnemonicParsing="false" onAction="#irProva_pesos" text="Média" />
               </items>
               <cursor>
                  <Cursor fx:constant="HAND" />
               </cursor>
            </MenuButton>
            <MenuButton fx:id="btnAlunos" layoutX="1111.0" layoutY="33.0" mnemonicParsing="false" onAction="#irAlunos" opacity="0.0" prefHeight="43.0" prefWidth="184.0" style="-fx-background-color: transparent;">
               <items>
                  <MenuItem fx:id="btalunos_notas" mnemonicParsing="false" onAction="#irAlunos_notas" text="Notas" />
                  <MenuItem fx:id="btalunos_corrigir" mnemonicParsing="false" onAction="#irAlunos_corrigir" text="Corrigir" />
               </items>
               <cursor>
                  <Cursor fx:constant="HAND" />
               </cursor>
            </MenuButton>
         </children>
      </Pane>
   </content>
</ScrollPane>
